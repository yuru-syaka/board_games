<Project Sdk="Microsoft.NET.Sdk">
  <!--
    オンライン対戦サーバーの負荷試験（ステップ 6-2）。本番（wss://ws.boardgamepia.com）につなぎ、
    ルームコードで組んだ 2 人ずつが、ゴースト・マルバツを最後まで対局する。
    ルールとロビーのメッセージは、ゲームとサーバーと同じ shared/ のコードを使う。
    使い方は tools/LoadTest/README.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\dotnet\BoardGames.Core\BoardGames.Core.csproj" />
    <ProjectReference Include="..\..\shared\dotnet\BoardGames.Vanish.Logic\BoardGames.Vanish.Logic.csproj" />
    <ProjectReference Include="..\..\shared\dotnet\BoardGames.Net.Protocol\BoardGames.Net.Protocol.csproj" />
  </ItemGroup>
</Project>
